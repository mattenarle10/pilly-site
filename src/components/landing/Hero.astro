---
import { Image } from 'astro:assets';

import capsule from '../../assets/brand/capsule.png';
import { site } from '../../config';
---

<section class="hero" data-landing-hero>
  <div class="dose-orbit dose-orbit-left" aria-hidden="true">
    <span>6:30</span><span>8:00</span><span>9:00</span>
  </div>
  <div class="dose-orbit dose-orbit-right" aria-hidden="true">
    <span>12:30</span><span>5:00</span><span>9:00</span>
  </div>

  <div class="hero-inner shell">
    <div class="hero-mark" aria-hidden="true" data-hero-pill>
      <Image src={capsule} width={220} height={220} alt="" format="webp" />
    </div>
    <p class="hero-kicker">Your medicines. Your rhythm.</p>
    <h1>Know what’s due.<br />Then get on with your day.</h1>
    <p class="hero-lede">Reminders, schedules, and dose history—clear at a glance.</p>
    <a class="button primary" href={`mailto:${site.supportEmail}?subject=Pilly%20early%20access`}>
      Join early access
    </a>
    <p class="hero-footnote">Built for iPhone. No account required.</p>
  </div>
</section>
