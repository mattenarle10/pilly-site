---
import RoutinePreview from '../components/RoutinePreview.astro';
import PillyPlusCompanion from '../components/PillyPlusCompanion.astro';
import SiteLayout from '../layouts/SiteLayout.astro';
import { site } from '../config';
---

<SiteLayout>
  <section class="hero shell">
    <div class="hero-copy">
      <p class="eyebrow">Medicine tracking, made calmer</p>
      <h1>A calmer way to keep up with your medicines.</h1>
      <p class="lede">
        Pilly keeps reminders, schedules, and dose history clear on your iPhone. Start locally—an
        account is always optional.
      </p>
      <div class="hero-actions">
        <a
          class="button primary"
          href={`mailto:${site.supportEmail}?subject=Pilly%20early%20access`}
        >Join early access</a>
      </div>
      <p class="fine-print">Built for iPhone. Private by default.</p>
    </div>
    <div class="hero-visual">
      <RoutinePreview />
      <div class="floating-reminder" aria-hidden="true">
        <img src="/app-icon.png" width="38" height="38" alt="" />
        <div><strong>Medicine due now</strong><span>Open Pilly to record it.</span></div>
      </div>
    </div>
  </section>

  <section class="section shell private-section">
    <div class="private-copy">
      <p class="eyebrow">Local first</p>
      <h2>Your medicines don’t need an account.</h2>
      <p>
        Pilly’s free tracker works on your iPhone without sign-in. Reminders are scheduled on your
        device, and notification text stays discreet.
      </p>
      <a class="text-link" href="/privacy/">Read the privacy policy <span aria-hidden="true">→</span></a>
    </div>
    <div class="privacy-seal" aria-hidden="true">
      <span class="seal-ring"></span>
      <span class="seal-pill"></span>
      <strong>Local</strong>
    </div>
  </section>

  <section class="section shell plus-section">
    <div class="plus-art"><PillyPlusCompanion /></div>
    <div class="plus-copy">
      <p class="eyebrow">Optional with Pilly Plus</p>
      <h2>Your routine follows you.</h2>
      <p>Private cloud backup, recovery on another iPhone, and medicine recognition photos.</p>
      <ul class="check-list">
        <li>Choose when backup begins</li>
        <li>Recover your records on another device</li>
        <li>Delete your cloud account from Pilly</li>
      </ul>
    </div>
  </section>

</SiteLayout>
